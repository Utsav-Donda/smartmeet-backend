# Runtime environment: development | test | production
NODE_ENV=development

# Port the HTTP/Socket.io server listens on — keep in sync with
# flutter_app/.env's API_BASE_URL/SOCKET_URL and docker-compose.yml's
# BACKEND_PORT, which both assume 3000.
PORT=3000

# PostgreSQL connection string. Must match the credentials docker-compose.yml
# provisions (POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB in the root .env) if
# you're using ./scripts/docker-up.sh — the defaults below match that setup.
DATABASE_URL=postgresql://smartmeet:change_me_in_production@localhost:5432/smartmeet

# Redis connection string used for caching, signaling state, and the Socket.io adapter
REDIS_URL=redis://localhost:6379

# Secret used to sign short-lived JWT access tokens - keep this out of version control
JWT_SECRET=change-me-access-secret

# Secret used to sign long-lived JWT refresh tokens - must differ from JWT_SECRET
JWT_REFRESH_SECRET=change-me-refresh-secret

# Access token lifetime (e.g. 15m, 1h)
JWT_ACCESS_EXPIRY=15m

# Refresh token lifetime (e.g. 7d, 30d)
JWT_REFRESH_EXPIRY=7d

# AWS IAM access key id for S3 recording storage - leave empty to fall back to local disk storage
AWS_ACCESS_KEY_ID=

# AWS IAM secret access key paired with AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=

# S3 bucket name where recordings are uploaded
AWS_S3_BUCKET=smartmeet-recordings

# AWS region the S3 bucket lives in
AWS_REGION=us-east-1

# Rate limiter window size in milliseconds
RATE_LIMIT_WINDOW_MS=900000

# Max requests allowed per IP per rate limit window
RATE_LIMIT_MAX_REQUESTS=100

# Minimum pino log level: debug | info | warn | error
LOG_LEVEL=info

# Toggles collection of in-memory/redis-backed API + socket metrics (true|false)
ENABLE_METRICS=true

# mediasoup SFU: number of Worker subprocesses, the UDP/TCP port range each
# WebRtcTransport allocates from (must be published/reachable — see
# docker-compose.yml's port mapping), and the IP clients should actually
# send RTP to (your LAN IP for local dev, the box's public IP in
# production — never 127.0.0.1/0.0.0.0, every client behind a NAT would
# fail to connect).
MEDIASOUP_NUM_WORKERS=2
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=40099
MEDIASOUP_ANNOUNCED_IP=127.0.0.1
